#!/usr/bin/env bash
# post-commit hook — the daily playable build (USER 2026-11-24; tools/ci/daily_build.py).
# When the `nightly` release is > 24 h old and master has new commits: build_all → push master → dispatch
# nightly.yml.  Runs detached so the commit returns at once; log: .git/daily-build.log.
# Opt out for one commit: DAILY_BUILD=0 git commit ...
[[ "${DAILY_BUILD:-1}" == "0" ]] && exit 0
root="$(git rev-parse --show-toplevel)"
log="$(git rev-parse --git-dir)/daily-build.log"
lock="$(git rev-parse --git-dir)/daily-build.lock"
( cd "$root" && nohup flock -n "$lock" python3 tools/ci/daily_build.py >>"$log" 2>&1 & ) >/dev/null 2>&1
exit 0
